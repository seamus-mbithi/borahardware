rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: readable and updatable by all clients
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: all customer orders and sales sync to this shared collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Health check / connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
